# GitHub personal access token used ONLY by the sync script (scripts/sync-github.ts).
# It is read from process.env.GITHUB_TOKEN and never shipped to the frontend or
# any build artifact. Create a local .env (git-ignored) or export it inline:
#   GITHUB_TOKEN=ghp_xxx npm run sync
GITHUB_TOKEN=

# Vercel Deploy Hook URL. When set, the sync script pings this URL after a
# successful sync to trigger a fresh production deployment on Vercel.
# Create one in Vercel: Project → Settings → Git → Deploy Hooks → Create Hook.
# This value should be stored as the VERCEL_DEPLOY_HOOK_URL GitHub Actions
# secret (not committed), so the scheduled CI sync can redeploy automatically.
VERCEL_DEPLOY_HOOK_URL=
